task.spawn(function()
    while task.wait(0.1) do
        if SpeedSettings.Enabled and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if root and hum then
                hum.WalkSpeed = SpeedSettings.WalkSpeed
                local direction = hum.MoveDirection
                if direction.Magnitude > 0 then
                    root.AssemblyLinearVelocity = direction * (SpeedSettings.WalkSpeed + 2.5)
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        if ESP_Settings.Enabled then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character then
                    local char = v.Character
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local highlight = root:FindFirstChild("BloodESP") or Instance.new("Highlight")
                        highlight.Name = "BloodESP"
                        highlight.Parent = root
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.new(1, 1, 1)
                        highlight.OutlineTransparency = 0
                    end
                end
            end
        else
            for _, v in pairs(Players:GetPlayers()) do
                if v.Character then
                    local root = v.Character:FindFirstChild("HumanoidRootPart")
                    if root and root:FindFirstChild("BloodESP") then
                        root.BloodESP:Destroy()
                    end
                end
            end
        end
        task.wait(1)
    end
end)

SpeedTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local val = tonumber(SpeedTextBox.Text)
        if val then
            SpeedSettings.WalkSpeed = val
            SpeedSettings.Enabled = true
        end
    end
end)

ESPButton.MouseButton1Click:Connect(function()
    ESP_Settings.Enabled = not ESP_Settings.Enabled
    ESPButton.Text = ESP_Settings.Enabled and "ESP: ON" or "ESP: OFF"
    ESPButton.TextColor3 = ESP_Settings.Enabled and Color3.fromRGB(0, 255, 0) or Theme.Text
end)

