MinimizeBtn.MouseButton1Click:Connect(function()
    Minimized = not Minimized
    local targetSize = Minimized and UDim2.new(0, 150, 0, 40) or UDim2.new(0, 400, 0, 250)
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {Size = targetSize}):Play()
end)

print("Blood Hub Loaded Successfully.")
